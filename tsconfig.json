{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "declaration": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "outDir": "lib",
    "rootDir": ".",
    "paths": { "*": ["./behavior_packs/*"] },
    "listFiles": false,
    "noEmitHelpers": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*"],
  "exclude": ["lib", "dist", "node_modules"],
  "compileOnSave": false
}
